                genre: "Crime",
                trailer: "https://www.youtube.com/embed/example3",
                badge: "Most Awaited"
            },
            {
                id: 4,
                title: "War 2",
                poster: "https://via.placeholder.com/220x300?text=War+2",
                release: "Oct 10, 2025",
                rating: 0,
                director: "Siddharth Anand",
                cast: "Hrithik Roshan, Jr. NTR",
                genre: "Action",
                trailer: "https://www.youtube.com/embed/example4",
                badge: "Upcoming"
            },
            {
                id: 5,
                title: "Tiger vs Pathaan",
                poster: "https://via.placeholder.com/220x300?text=Tiger+vs+Pathaan",
                release: "Nov 12, 2025",
                rating: 0,
                director: "Maneesh Sharma",
                cast: "Salman Khan, Shah Rukh Khan",
                genre: "Action",
                trailer: "https://www.youtube.com/embed/example5",
                badge: "Upcoming"
            },
            {
                id: 6,
                title: "KGF: Chapter 3",
                poster: "https://via.placeholder.com/220x300?text=KGF+3",
                release: "Aug 30, 2025",
                rating: 0,
                director: "Prashanth Neel",
                cast: "Yash, Sanjay Dutt",
                genre: "Action",
                trailer: "https://www.youtube.com/embed/example6",
                badge: "Upcoming"
            },
            {
                id: 7,
                title: "Pushpa 2: The Rule",
                poster: "https://via.placeholder.com/220x300?text=Pushpa+2",
                release: "Dec 6, 2025",
                rating: 0,
                director: "Sukumar",
                cast: "Allu Arjun, Rashmika Mandanna",
                genre: "Action",
                trailer: "https://www.youtube.com/embed/example7",
                badge: "Upcoming"
            },
            {
                id: 8,
                title: "Jawan 2",
                poster: "https://via.placeholder.com/220x300?text=Jawan+2",
                release: "Sep 5, 2025",
                rating: 0,
                director: "Atlee",
                cast: "Shah Rukh Khan, Nayanthara",
                genre: "Action",
                trailer: "https://www.youtube.com/embed/example8",
                badge: "Upcoming"
            }
        ];

        // DOM Elements
        const moviesGrid = document.getElementById('moviesGrid');
        const hamburger = document.querySelector('.hamburger');
        const mainNav = document.querySelector('.main-nav');
        const heroSlides = document.querySelectorAll('.hero-slide');
        const indicators = document.querySelectorAll('.indicator');
        const trailerBtns = document.querySelectorAll('.watch-trailer');
        const trailerModal = document.getElementById('trailerModal');
        const trailerFrame = document.getElementById('trailerFrame');
        const closeModalBtn = document.querySelector('.close-modal');

        // Generate Movie Cards
        function generateMovieCards() {
            moviesGrid.innerHTML = '';
            
            moviesData.forEach(movie => {
                const movieCard = document.createElement('div');
                movieCard.className = 'movie-card';
                movieCard.innerHTML = `
                    <img src="${movie.poster}" alt="${movie.title}" class="movie-poster">
                    ${movie.badge ? `<div class="movie-badge">${movie.badge}</div>` : ''}
                    <button class="watchlist-btn" data-id="${movie.id}">
                        <i class="material-icons">favorite_border</i>
                    </button>
                    <div class="movie-info">
                        <h3 class="movie-title">${movie.title}</h3>
                        <div class="movie-meta">
                            <span>${movie.release}</span>
                            <span class="movie-rating">
                                <i class="material-icons">star</i>
                                ${movie.rating > 0 ? movie.rating : 'Coming Soon'}
                            </span>
                        </div>
                        <p class="movie-director">Dir: ${movie.director}</p>
                        <p class="movie-cast">Cast: ${movie.cast}</p>
                        <button class="btn btn-outline watch-trailer" data-trailer="${movie.trailer}" style="width: 100%; margin-top: 10px;">
                            <i class="material-icons">play_arrow</i> Trailer
                        </button>
                    </div>
                `;
                moviesGrid.appendChild(movieCard);
            });
        }

        // Initialize Carousel
        let currentSlide = 0;
        
        function showSlide(index) {
            heroSlides.forEach(slide => slide.classList.remove('active'));
            indicators.forEach(indicator => indicator.classList.remove('active'));
            
            currentSlide = (index + heroSlides.length) % heroSlides.length;
            heroSlides[currentSlide].classList.add('active');
            indicators[currentSlide].classList.add('active');
        }
        
        function nextSlide() {
            showSlide(currentSlide + 1);
        }
        
        // Auto slide every 5 seconds
        let slideInterval = setInterval(nextSlide, 5000);

        // Pause on hover
        const heroBanner = document.querySelector('.hero-banner');
        heroBanner.addEventListener('mouseenter', () => clearInterval(slideInterval));
        heroBanner.addEventListener('mouseleave', () => {
            slideInterval = setInterval(nextSlide, 5000);
        });

        // Indicator click
        indicators.forEach((indicator, index) => {
            indicator.addEventListener('click', () => {
                showSlide(index);
                clearInterval(slideInterval);
                slideInterval = setInterval(nextSlide, 5000);
            });
        });

        // Mobile Navigation
        hamburger.addEventListener('click', () => {
            mainNav.classList.toggle('active');
        });

        // Watchlist Functionality
        document.addEventListener('click', function(e) {
            if (e.target.closest('.watchlist-btn')) {
                const btn = e.target.closest('.watchlist-btn');
                const icon = btn.querySelector('i');
                
                btn.classList.toggle('active');
                if (btn.classList.contains('active')) {
                    icon.textContent = 'favorite';
                    // In real app, save to localStorage or send to server
                } else {
                    icon.textContent = 'favorite_border';
                }
            }
        });

        // Trailer Modal
        function openTrailerModal(trailerUrl) {
            trailerFrame.src = trailerUrl;
            trailerModal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
        
        function closeTrailerModal() {
            trailerFrame.src = '';
            trailerModal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('watch-trailer')) {
                e.preventDefault();
                const trailerUrl = e.target.getAttribute('data-trailer');
                openTrailerModal(trailerUrl);
            }
            
            if (e.target === trailerModal || e.target.classList.contains('close-modal')) {
                closeTrailerModal();
            }
        });

        // Close modal with ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && trailerModal.style.display === 'block') {
                closeTrailerModal();
            }
        });

        // Initialize
        generateMovieCards();
        showSlide(0);
    </script>
